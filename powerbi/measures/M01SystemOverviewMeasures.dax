-- Power BI M01 - System Overview measures.
--
-- ManagementComparableTrip is one row per ServiceDate + TripKey and is built
-- from the deployed realtime reliability outcome view. ManagementTripStation
-- keeps the station/stop grain for stop counts and station comparisons.
-- Punctuality uses the final observed estimated-arrival difference.

Delay Threshold (Minutes) =
SELECTEDVALUE ( 'Delay Threshold (Minutes)'[Value], 0 )

M01 Effective Threshold Display =
FORMAT (
    [Delay Threshold (Minutes)],
    "0",
    "en-US"
) & " min"

Comparable Scheduled Trips =
COUNTROWS ( ManagementComparableTrip )

Scheduled Trips in Monitored Scope =
[Comparable Scheduled Trips]

Observed Realtime Trips =
CALCULATE (
    COUNTROWS ( ManagementComparableTrip ),
    ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
)

Timing Unavailable Trips =
COALESCE ( [Comparable Scheduled Trips], 0 )
    - COALESCE ( [Observed Realtime Trips], 0 )

Observed Matched Trips =
[Observed Realtime Trips]

On-Time Trips =
CALCULATE (
    COUNTROWS ( ManagementComparableTrip ),
    FILTER (
        ManagementComparableTrip,
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
            && ABS ( ManagementComparableTrip[FinalObservedEstimatedDelayMinutes] )
                <= [Delay Threshold (Minutes)]
    )
)

Delayed Trips =
CALCULATE (
    COUNTROWS ( ManagementComparableTrip ),
    FILTER (
        ManagementComparableTrip,
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
            && ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
                > [Delay Threshold (Minutes)]
    )
)

Early Trips =
CALCULATE (
    COUNTROWS ( ManagementComparableTrip ),
    FILTER (
        ManagementComparableTrip,
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
            && ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
                < ( 0 - [Delay Threshold (Minutes)] )
    )
)

On-Time % =
DIVIDE ( [On-Time Trips], [Observed Realtime Trips] )

Delayed % =
DIVIDE ( [Delayed Trips], [Observed Realtime Trips] )

Early % =
DIVIDE ( [Early Trips], [Observed Realtime Trips] )

Average Schedule Difference Minutes =
AVERAGEX (
    FILTER (
        ManagementComparableTrip,
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
    ),
    ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
)

Average Absolute Schedule Gap Minutes =
AVERAGEX (
    FILTER (
        ManagementComparableTrip,
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
    ),
    ABS ( ManagementComparableTrip[FinalObservedEstimatedDelayMinutes] )
)

Mode Route Count =
SUM ( Mode[RouteCount] )

Network Parent Stations =
DISTINCTCOUNT ( ParentStation[ParentStationKey] )

Realtime Monitored Stations =
CALCULATE (
    DISTINCTCOUNT ( ManagementMonitoredStation[SamplingTargetId] ),
    ManagementMonitoredStation[ParticipatedInSamplingPanel] = TRUE ()
)

Realtime Data Start Date =
MIN ( ManagementMonitoredStation[CollectionDateLocal] )

Realtime Data End Date =
MAX ( ManagementMonitoredStation[CollectionDateLocal] )

Realtime Observed Days =
DISTINCTCOUNT ( ManagementMonitoredStation[DateKey] )

Realtime Covered Days =
[Realtime Observed Days]

Observed Stop Positions =
CALCULATE (
    DISTINCTCOUNT ( ManagementTripStation[StopKey] ),
    ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
)

M01 Routes Display =
FORMAT ( COALESCE ( [Mode Route Count], 0 ), "#,##0", "en-US" )

M01 Network Stations Display =
FORMAT ( COALESCE ( [Network Parent Stations], 0 ), "#,##0", "en-US" )

M01 Monitored Stations Display =
FORMAT ( COALESCE ( [Realtime Monitored Stations], 0 ), "#,##0", "en-US" )

M01 Observed Stop Positions Display =
FORMAT ( COALESCE ( [Observed Stop Positions], 0 ), "#,##0", "en-US" )

M01 Collector Start Display =
VAR CollectorStart =
    CALCULATE (
        [Realtime Data Start Date],
        REMOVEFILTERS ( ManagementDate )
    )
RETURN
    IF (
        ISBLANK ( CollectorStart ),
        "No data",
        FORMAT ( CollectorStart, "d MMM yyyy", "en-US" )
    )

M01 Collector End Display =
VAR CollectorEnd =
    CALCULATE (
        [Realtime Data End Date],
        REMOVEFILTERS ( ManagementDate )
    )
RETURN
    IF (
        ISBLANK ( CollectorEnd ),
        "No data",
        FORMAT ( CollectorEnd, "d MMM yyyy", "en-US" )
    )

M01 Observed Days Display =
FORMAT (
    COALESCE (
        CALCULATE (
            [Realtime Observed Days],
            REMOVEFILTERS ( ManagementDate )
        ),
        0
    ),
    "#,##0",
    "en-US"
)

M01 Scheduled Trips Display =
FORMAT ( COALESCE ( [Scheduled Trips in Monitored Scope], 0 ), "#,##0", "en-US" )

M01 Observed Realtime Trips Display =
FORMAT ( COALESCE ( [Observed Realtime Trips], 0 ), "#,##0", "en-US" )

M01 Timing Unavailable Display =
FORMAT ( COALESCE ( [Timing Unavailable Trips], 0 ), "#,##0", "en-US" )

Punctuality Trips =
VAR SelectedStatus = SELECTEDVALUE ( PunctualityStatus[Status] )
RETURN
    SWITCH (
        SelectedStatus,
        "On Time", COALESCE ( [On-Time Trips], 0 ),
        "Delayed", COALESCE ( [Delayed Trips], 0 ),
        "Early", COALESCE ( [Early Trips], 0 )
    )

Punctuality % =
VAR SelectedStatus = SELECTEDVALUE ( PunctualityStatus[Status] )
RETURN
    SWITCH (
        SelectedStatus,
        "On Time", COALESCE ( [On-Time %], 0 ),
        "Delayed", COALESCE ( [Delayed %], 0 ),
        "Early", COALESCE ( [Early %], 0 )
    )

Station Comparable Trips =
DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] )

Station Observed Realtime Trips =
CALCULATE (
    DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] ),
    ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
)

Station Observed Matched Trips =
[Station Observed Realtime Trips]

Station On-Time Trips =
CALCULATE (
    DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] ),
    FILTER (
        ManagementTripStation,
        ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
            && ABS ( ManagementTripStation[FinalObservedEstimatedDelayMinutes] )
                <= [Delay Threshold (Minutes)]
    )
)

Station On-Time % =
DIVIDE ( [Station On-Time Trips], [Station Observed Realtime Trips] )

Station Delayed Trips =
CALCULATE (
    DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] ),
    FILTER (
        ManagementTripStation,
        ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
            && ManagementTripStation[FinalObservedEstimatedDelayMinutes]
                > [Delay Threshold (Minutes)]
    )
)

Station Delayed % =
DIVIDE ( [Station Delayed Trips], [Station Observed Realtime Trips] )

Station Average Absolute Schedule Gap Minutes =
AVERAGEX (
    FILTER (
        ManagementTripStation,
        ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
    ),
    ABS ( ManagementTripStation[FinalObservedEstimatedDelayMinutes] )
)

Best Performing Mode Name =
VAR ModeRows =
    ADDCOLUMNS (
        ALLSELECTED ( Mode[ModeDetail] ),
        "__OnTime", CALCULATE ( [On-Time %] ),
        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Observed Realtime Trips] )
    )
VAR TopMode =
    TOPN (
        1,
        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], DESC,
        [__Gap], ASC,
        [__Observed], DESC,
        Mode[ModeDetail], ASC
    )
RETURN
    MAXX ( TopMode, Mode[ModeDetail] )

Worst Performing Mode Name =
VAR ModeRows =
    ADDCOLUMNS (
        ALLSELECTED ( Mode[ModeDetail] ),
        "__OnTime", CALCULATE ( [On-Time %] ),
        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Observed Realtime Trips] )
    )
VAR BottomMode =
    TOPN (
        1,
        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], ASC,
        [__Gap], ASC,
        [__Observed], DESC,
        Mode[ModeDetail], ASC
    )
RETURN
    MAXX ( BottomMode, Mode[ModeDetail] )

Best Performing Mode =
VAR ModeRows =
    ADDCOLUMNS (
        ALLSELECTED ( Mode[ModeDetail] ),
        "__OnTime", CALCULATE ( [On-Time %] ),
        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Observed Realtime Trips] )
    )
VAR TopMode =
    TOPN (
        1,
        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], DESC,
        [__Gap], ASC,
        [__Observed], DESC,
        Mode[ModeDetail], ASC
    )
VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
VAR ModePct = MAXX ( TopMode, [__OnTime] )
VAR ObservedTrips = MAXX ( TopMode, [__Observed] )
RETURN
    IF (
        ISBLANK ( ModeName ),
        "No observed realtime trips are available for the current selection.",
        ModeName & " | "
            & FORMAT ( ModePct, "0.0%", "en-US" ) & " | "
            & FORMAT ( ObservedTrips, "#,##0", "en-US" ) & " trips"
    )

Worst Performing Mode =
VAR ModeRows =
    ADDCOLUMNS (
        ALLSELECTED ( Mode[ModeDetail] ),
        "__OnTime", CALCULATE ( [On-Time %] ),
        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Observed Realtime Trips] )
    )
VAR BottomMode =
    TOPN (
        1,
        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], ASC,
        [__Gap], ASC,
        [__Observed], DESC,
        Mode[ModeDetail], ASC
    )
VAR ModeName = MAXX ( BottomMode, Mode[ModeDetail] )
VAR ModePct = MAXX ( BottomMode, [__OnTime] )
VAR ObservedTrips = MAXX ( BottomMode, [__Observed] )
RETURN
    IF (
        ISBLANK ( ModeName ),
        "No observed realtime trips are available for the current selection.",
        ModeName & " | "
            & FORMAT ( ModePct, "0.0%", "en-US" ) & " | "
            & FORMAT ( ObservedTrips, "#,##0", "en-US" ) & " trips"
    )

Best Performing Monitored Station Name =
VAR StationRows =
    ADDCOLUMNS (
        ALLSELECTED ( ManagementTripStation[Station] ),
        "__OnTime", CALCULATE ( [Station On-Time %] ),
        "__Gap", CALCULATE ( [Station Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Station Observed Realtime Trips] )
    )
VAR TopStation =
    TOPN (
        1,
        FILTER ( StationRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], DESC,
        [__Gap], ASC,
        [__Observed], DESC,
        ManagementTripStation[Station], ASC
    )
RETURN
    MAXX ( TopStation, ManagementTripStation[Station] )

Worst Performing Monitored Station Name =
VAR StationRows =
    ADDCOLUMNS (
        ALLSELECTED ( ManagementTripStation[Station] ),
        "__OnTime", CALCULATE ( [Station On-Time %] ),
        "__Gap", CALCULATE ( [Station Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Station Observed Realtime Trips] )
    )
VAR BottomStation =
    TOPN (
        1,
        FILTER ( StationRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], ASC,
        [__Gap], ASC,
        [__Observed], DESC,
        ManagementTripStation[Station], ASC
    )
RETURN
    MAXX ( BottomStation, ManagementTripStation[Station] )

Best Performing Monitored Station =
VAR StationRows =
    ADDCOLUMNS (
        ALLSELECTED ( ManagementTripStation[Station] ),
        "__OnTime", CALCULATE ( [Station On-Time %] ),
        "__Gap", CALCULATE ( [Station Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Station Observed Realtime Trips] )
    )
VAR TopStation =
    TOPN (
        1,
        FILTER ( StationRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], DESC,
        [__Gap], ASC,
        [__Observed], DESC,
        ManagementTripStation[Station], ASC
    )
VAR StationName = MAXX ( TopStation, ManagementTripStation[Station] )
VAR StationPct = MAXX ( TopStation, [__OnTime] )
VAR ObservedTrips = MAXX ( TopStation, [__Observed] )
RETURN
    IF (
        ISBLANK ( StationName ),
        "No observed realtime station trips are available for the current selection.",
        StationName & UNICHAR ( 10 ) & FORMAT ( StationPct, "0.0%" )
            & " On Time" & UNICHAR ( 10 )
            & FORMAT ( ObservedTrips, "#,0" ) & " observed trips"
    )

Worst Performing Monitored Station =
VAR StationRows =
    ADDCOLUMNS (
        ALLSELECTED ( ManagementTripStation[Station] ),
        "__OnTime", CALCULATE ( [Station On-Time %] ),
        "__Gap", CALCULATE ( [Station Average Absolute Schedule Gap Minutes] ),
        "__Observed", CALCULATE ( [Station Observed Realtime Trips] )
    )
VAR BottomStation =
    TOPN (
        1,
        FILTER ( StationRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
        [__OnTime], ASC,
        [__Gap], ASC,
        [__Observed], DESC,
        ManagementTripStation[Station], ASC
    )
VAR StationName = MAXX ( BottomStation, ManagementTripStation[Station] )
VAR StationPct = MAXX ( BottomStation, [__OnTime] )
VAR ObservedTrips = MAXX ( BottomStation, [__Observed] )
RETURN
    IF (
        ISBLANK ( StationName ),
        "No observed realtime station trips are available for the current selection.",
        StationName & UNICHAR ( 10 ) & FORMAT ( StationPct, "0.0%" )
            & " On Time" & UNICHAR ( 10 )
            & FORMAT ( ObservedTrips, "#,0" ) & " observed trips"
    )

On-Time Summary =
IF (
    ISBLANK ( [Observed Realtime Trips] ) || [Observed Realtime Trips] = 0,
    "No observations",
    FORMAT ( COALESCE ( [On-Time Trips], 0 ), "#,##0", "en-US" ) & "  |  "
        & FORMAT ( COALESCE ( [On-Time %], 0 ), "0.0%", "en-US" )
)

Delayed Summary =
IF (
    ISBLANK ( [Observed Realtime Trips] ) || [Observed Realtime Trips] = 0,
    "No observations",
    FORMAT ( COALESCE ( [Delayed Trips], 0 ), "#,##0", "en-US" ) & "  |  "
        & FORMAT ( COALESCE ( [Delayed %], 0 ), "0.0%", "en-US" )
)

Early Summary =
IF (
    ISBLANK ( [Observed Realtime Trips] ) || [Observed Realtime Trips] = 0,
    "No observations",
    FORMAT ( COALESCE ( [Early Trips], 0 ), "#,##0", "en-US" ) & "  |  "
        & FORMAT ( COALESCE ( [Early %], 0 ), "0.0%", "en-US" )
)

Realtime Monitoring Scope Note =
"Realtime results represent the monitored sampling panel, not the full Cologne network. Realtime arrival values are estimates; timing unavailable does not imply cancellation."

System Status Summary Line 1 =
VAR ScheduledTrips = COALESCE ( [Comparable Scheduled Trips], 0 )
VAR ObservedTrips = COALESCE ( [Observed Realtime Trips], 0 )
VAR TimingUnavailable = COALESCE ( [Timing Unavailable Trips], 0 )
VAR StartDate =
    MIN ( ManagementComparableTrip[ServiceDate] )
VAR EndDate =
    MAX ( ManagementComparableTrip[ServiceDate] )
VAR DateRange =
    IF (
        YEAR ( StartDate ) = YEAR ( EndDate ),
        FORMAT ( StartDate, "d MMM", "en-US" )
            & UNICHAR ( 8211 )
            & FORMAT ( EndDate, "d MMM yyyy", "en-US" ),
        FORMAT ( StartDate, "d MMM yyyy", "en-US" )
            & UNICHAR ( 8211 )
            & FORMAT ( EndDate, "d MMM yyyy", "en-US" )
    )
RETURN
    IF (
        ISBLANK ( StartDate ) || ISBLANK ( EndDate ) || ScheduledTrips = 0,
        "Current status  |  No matched trips are available for the selected period.",
        "Current status  |  " & DateRange
            & "  |  Matched: "
            & FORMAT ( ScheduledTrips, "#,##0", "en-US" )
            & "  |  Usable timing: "
            & FORMAT ( ObservedTrips, "#,##0", "en-US" )
            & "  |  Timing unavailable: "
            & FORMAT ( TimingUnavailable, "#,##0", "en-US" )
    )

System Status Summary Line 2 =
VAR BestMode = [Best Performing Mode Name]
VAR WorstMode = [Worst Performing Mode Name]
RETURN
    IF (
        ISBLANK ( BestMode ) || ISBLANK ( WorstMode ),
        "No mode-level on-time comparison is available for the selected period.",
        "Best on-time: " & BestMode & "  |  Lowest: " & WorstMode
    )

System Status Summary =
VAR ObservedTrips = [Observed Realtime Trips]
VAR StartDate =
    CALCULATE (
        MIN ( ManagementComparableTrip[ServiceDate] ),
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
    )
VAR EndDate =
    CALCULATE (
        MAX ( ManagementComparableTrip[ServiceDate] ),
        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
    )
VAR ModeCount =
    COUNTROWS (
        FILTER (
            VALUES ( Mode[ModeDetail] ),
            CALCULATE ( [Observed Realtime Trips] ) > 0
        )
    )
VAR StationCount =
    COUNTROWS (
        FILTER (
            VALUES ( ManagementTripStation[Station] ),
            CALCULATE ( [Station Observed Realtime Trips] ) > 0
        )
    )
VAR BestMode = [Best Performing Mode Name]
VAR WorstMode = [Worst Performing Mode Name]
RETURN
    IF (
        ISBLANK ( ObservedTrips ) || ObservedTrips = 0,
        "No realtime trips with a usable estimated timing are available for the selected period.",
        "From " & FORMAT ( StartDate, "d MMM yyyy", "en-US" ) & " to "
            & FORMAT ( EndDate, "d MMM yyyy", "en-US" ) & ", "
            & FORMAT ( ObservedTrips, "#,##0", "en-US" ) & " realtime trips were observed across "
            & FORMAT ( ModeCount, "#,##0", "en-US" ) & " transport modes and "
            & FORMAT ( StationCount, "#,##0", "en-US" ) & " monitored stations."
            & UNICHAR ( 10 ) & BestMode & " has the highest on-time rate; "
            & WorstMode & " has the lowest."
    )
