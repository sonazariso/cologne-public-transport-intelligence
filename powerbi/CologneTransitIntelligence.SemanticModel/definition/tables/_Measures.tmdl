	measure 'Punctuality Trips' =
			
			VAR SelectedStatus = SELECTEDVALUE ( PunctualityStatus[Status] )
			RETURN
			    SWITCH (
			        SelectedStatus,
			        "On Time", COALESCE ( [On-Time Trips], 0 ),
			        "Delayed", COALESCE ( [Delayed Trips], 0 ),
			        "Early", COALESCE ( [Early Trips], 0 )
			    )
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000022

	measure 'Punctuality %' =
			
			VAR SelectedStatus = SELECTEDVALUE ( PunctualityStatus[Status] )
			RETURN
			    SWITCH (
			        SelectedStatus,
			        "On Time", COALESCE ( [On-Time %], 0 ),
			        "Delayed", COALESCE ( [Delayed %], 0 ),
			        "Early", COALESCE ( [Early %], 0 )
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000023

	measure 'Station Comparable Trips' =
			
			DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] )
