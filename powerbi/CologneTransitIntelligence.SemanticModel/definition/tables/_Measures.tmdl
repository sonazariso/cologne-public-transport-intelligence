	measure 'Realtime Monitoring Scope Note' =
			
			"Realtime results represent the monitored sampling panel, not the full Cologne network. Realtime arrival values are estimates; timing unavailable does not imply cancellation."
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000041

	measure 'System Status Summary' =
			
			VAR ObservedTrips = [Observed Realtime Trips]
			VAR StartDate =
			    CALCULATE (
			        MIN ( ManagementComparableTrip[ServiceDate] ),
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			    )
			VAR EndDate =
			    CALCULATE (
			        MAX ( ManagementComparableTrip[ServiceDate] ),
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			    )
			VAR ModeCount =
			    COUNTROWS (
			        FILTER (
			            VALUES ( Mode[ModeDetail] ),
			            CALCULATE ( [Observed Realtime Trips] ) > 0
			        )
			    )
			VAR StationCount =
			    COUNTROWS (
			        FILTER (
			            VALUES ( ManagementTripStation[Station] ),
			            CALCULATE ( [Station Observed Realtime Trips] ) > 0
			        )
			    )
			VAR BestMode = [Best Performing Mode Name]
			VAR WorstMode = [Worst Performing Mode Name]
			RETURN
			    IF (
			        ISBLANK ( ObservedTrips ) || ObservedTrips = 0,
			        "No realtime trips with a usable estimated timing are available for the selected period.",
			        "From " & FORMAT ( StartDate, "d MMM yyyy" ) & " to "
			            & FORMAT ( EndDate, "d MMM yyyy" ) & ", "
			            & FORMAT ( ObservedTrips, "#,0" ) & " realtime trips were observed across "
			            & FORMAT ( ModeCount, "#,0" ) & " transport modes and "
			            & FORMAT ( StationCount, "#,0" ) & " monitored stations."
			            & UNICHAR ( 10 ) & BestMode & " has the highest on-time rate; "
			            & WorstMode & " has the lowest."
			    )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000042

	measure 'Station Delayed Trips' =
			
			CALCULATE (
			    DISTINCTCOUNT ( ManagementTripStation[ManagementTripKey] ),
			    FILTER (
			        ManagementTripStation,
			        ManagementTripStation[HasValidRealtimeObservation] = TRUE ()
			            && ManagementTripStation[FinalObservedEstimatedDelayMinutes]
			                > [Delay Threshold (Minutes)]
			    )
			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000043

	measure 'Station Delayed %' =
			
			DIVIDE ( [Station Delayed Trips], [Station Observed Realtime Trips] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000044

	measure 'Timing Unavailable Trips' =
			
			COALESCE ( [Comparable Scheduled Trips], 0 )
			    - COALESCE ( [Observed Realtime Trips], 0 )
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000045

	measure 'M01 Routes Display' =
			
			FORMAT ( COALESCE ( [Mode Route Count], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000046

	measure 'M01 Network Stations Display' =
			
			FORMAT ( COALESCE ( [Network Parent Stations], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000047

	measure 'M01 Monitored Stations Display' =
			
			FORMAT ( COALESCE ( [Realtime Monitored Stations], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000048

	measure 'M01 Observed Stop Positions Display' =
			
			FORMAT ( COALESCE ( [Observed Stop Positions], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000049

	measure 'M01 Collector Start Display' =
			
			VAR CollectorStart =
			    CALCULATE (
			        [Realtime Data Start Date],
			        REMOVEFILTERS ( ManagementDate )
			    )
			RETURN
			    IF (
			        ISBLANK ( CollectorStart ),
			        "No data",
			        FORMAT ( CollectorStart, "d MMM yyyy", "en-US" )
			    )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004a

	measure 'M01 Collector End Display' =
			
			VAR CollectorEnd =
			    CALCULATE (
			        [Realtime Data End Date],
			        REMOVEFILTERS ( ManagementDate )
			    )
			RETURN
			    IF (
			        ISBLANK ( CollectorEnd ),
			        "No data",
			        FORMAT ( CollectorEnd, "d MMM yyyy", "en-US" )
			    )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004b

	measure 'M01 Observed Days Display' =
			
			FORMAT (
			    COALESCE (
			        CALCULATE (
			            [Realtime Observed Days],
			            REMOVEFILTERS ( ManagementDate )
			        ),
			        0
			    ),
			    "#,##0",
			    "en-US"
			)
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004c

	measure 'M01 Scheduled Trips Display' =
			
			FORMAT ( COALESCE ( [Scheduled Trips in Monitored Scope], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004d

	measure 'M01 Observed Realtime Trips Display' =
			
			FORMAT ( COALESCE ( [Observed Realtime Trips], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004e

	measure 'M01 Timing Unavailable Display' =
			
			FORMAT ( COALESCE ( [Timing Unavailable Trips], 0 ), "#,##0", "en-US" )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-00000000004f

	measure 'System Status Summary Line 1' =
			
			VAR ScheduledTrips = COALESCE ( [Comparable Scheduled Trips], 0 )
			VAR ObservedTrips = COALESCE ( [Observed Realtime Trips], 0 )
			VAR TimingUnavailable = COALESCE ( [Timing Unavailable Trips], 0 )
			VAR StartDate =
			    MIN ( ManagementComparableTrip[ServiceDate] )
			VAR EndDate =
			    MAX ( ManagementComparableTrip[ServiceDate] )
			VAR DateRange =
			    IF (
			        YEAR ( StartDate ) = YEAR ( EndDate ),
			        FORMAT ( StartDate, "d MMM", "en-US" )
			            & UNICHAR ( 8211 )
			            & FORMAT ( EndDate, "d MMM yyyy", "en-US" ),
			        FORMAT ( StartDate, "d MMM yyyy", "en-US" )
			            & UNICHAR ( 8211 )
			            & FORMAT ( EndDate, "d MMM yyyy", "en-US" )
			    )
			RETURN
			    IF (
			        ISBLANK ( StartDate ) || ISBLANK ( EndDate ) || ScheduledTrips = 0,
			        "Current status  |  No matched trips are available for the selected period.",
			        "Current status  |  " & DateRange
			            & "  |  Matched: "
			            & FORMAT ( ScheduledTrips, "#,##0", "en-US" )
			            & "  |  Usable timing: "
			            & FORMAT ( ObservedTrips, "#,##0", "en-US" )
			            & "  |  Timing unavailable: "
			            & FORMAT ( TimingUnavailable, "#,##0", "en-US" )
			    )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000050

	measure 'System Status Summary Line 2' =

			VAR BestMode = [Best Performing Mode]
			VAR WorstMode = [Worst Performing Mode]
			RETURN
			    IF (
			        ISBLANK ( BestMode ) || ISBLANK ( WorstMode ),
			        "No mode-level on-time comparison is available for the selected period.",
			        "Best: " & BestMode
			            & "    |    Worst: " & WorstMode
			    )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000051

	measure 'M01 Effective Threshold Display' =
			
			FORMAT (
			    [Delay Threshold (Minutes)],
			    "0",
			    "en-US"
			) & " min"
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000052

