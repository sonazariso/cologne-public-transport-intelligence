		formatString: 0
		displayFolder: 02 Network Baseline
		lineageTag: 3dac2baa-ebec-44db-8dc9-41d88ea87155

	measure 'Baseline Parent Stations' =
			
			MAX ( NetworkKPI[ParentStationCount] )
		formatString: 0
		displayFolder: 02 Network Baseline
		lineageTag: dafc932d-0eb0-47fb-97ef-5b210fdcdad9

	measure 'Baseline Stop Positions' =
			
