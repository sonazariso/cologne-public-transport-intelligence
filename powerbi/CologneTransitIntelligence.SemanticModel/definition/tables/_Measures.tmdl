		formatString: 0
		displayFolder: 02 Network Baseline
		lineageTag: 1957e796-3f55-438a-a082-d2ba8b720193

	measure 'Baseline Scheduled Trip Patterns' =
			
			MAX ( NetworkKPI[ScheduledTripPatternCount] )
		formatString: 0
		displayFolder: 02 Network Baseline
		lineageTag: 3842d4a6-015d-45f2-89c3-b20dc4c0a97f

