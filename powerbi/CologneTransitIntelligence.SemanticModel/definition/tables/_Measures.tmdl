	measure 'Collector Runs' =
			
			COUNTROWS ( RT_CollectorRunHealth )
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: 3270dbcc-4ac4-482f-9177-544b2c83623b

	measure 'Successful Collector Runs' =
			
			CALCULATE (
			    [Collector Runs],
			    RT_CollectorRunHealth[IsSuccessfulRun] = TRUE ()
			)
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: e8f5b604-8d01-48f1-a1df-8d53e4b29368

	measure 'Failed Collector Runs' =
			
			CALCULATE (
			    [Collector Runs],
			    RT_CollectorRunHealth[IsFailedRun] = TRUE ()
			)
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: 88beac19-c78c-4037-b317-36c8321f07d8

	measure 'Incomplete Collector Runs' =
			
			CALCULATE (
			    [Collector Runs],
			    RT_CollectorRunHealth[IsIncompleteStartedRun] = TRUE ()
			)
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: 2609ab0f-7046-46d4-afe7-b5460422bdd0

	measure 'Successful Automatic Runs' =
			
			CALCULATE (
			    [Collector Runs],
			    RT_CollectorRunHealth[IsSuccessfulAutomaticRun] = TRUE ()
			)
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: be58d68a-d826-45f8-85ef-a386abf40ac3

	measure 'Completed Collector Runs' =
			
			[Successful Collector Runs]
			    + [Failed Collector Runs]
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: c04312d7-4ef0-438c-81d3-fd1b013b8a50

	measure 'Collector Success Rate' =
			
			DIVIDE (
			    [Successful Collector Runs],
			    [Completed Collector Runs],
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 07 Collector Health
		lineageTag: 6e31910f-98a6-4839-90bb-8b5a35dc480e

	measure 'Sampling Panel Targets Observed' =
			
			CALCULATE (
			    DISTINCTCOUNT ( RT_CollectorRunHealth[SamplingTargetId] ),
			    RT_CollectorRunHealth[ParticipatedInSamplingPanel] = TRUE ()
			)
		formatString: #,0
		displayFolder: 07 Collector Health
		lineageTag: c11e7411-1d59-442c-8e1a-af30a1778e71

	measure 'Average Successful Run Duration (sec)' =
			
			DIVIDE (
			    CALCULATE (
			        AVERAGE ( RT_CollectorRunHealth[DurationMs] ),
			        RT_CollectorRunHealth[IsSuccessfulRun] = TRUE ()
			    ),
			    1000
			)
		formatString: #,0.00
		displayFolder: 07 Collector Health
		lineageTag: 8637b6b8-4db8-4204-b8f6-a126e07f0f79

	measure 'Agencies in Context' =
			
			DISTINCTCOUNT ( DailySchedule[AgencyId] )
		formatString: #,0
		displayFolder: 01 Static Schedule
		lineageTag: 8be1fb2f-c122-42f8-a65a-92a9ae3e0869

	/// Static parent-station scheduled trip-pattern volume for station ranking.
	/// DailySchedule is route-grain and has no station key; [Scheduled Trips]
	/// cannot be sliced by ParentStation without changing the approved model.
	measure 'Parent Station Scheduled Trip Patterns' =
			
			SUM ( ParentStation[ScheduledTripPatternCount] )
		formatString: #,0
		displayFolder: 01 Static Schedule
		lineageTag: 87fac219-e1da-44ec-82c7-4b7d9e97764b

	/// Observed matched services represented by each transport mode as a
	/// share of the current Sampling Panel outcome total.
	measure 'Mode Share of Observed Services' =
			
			DIVIDE (
			    [Observed Matched Services],
			    CALCULATE (
			        [Observed Matched Services],
			        REMOVEFILTERS ( Mode )
			    ),
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 08 Management Overview
		lineageTag: 4c8f6a1d-3c2a-4d1e-a879-1b2c3d4e5f60

	measure Routes =
			
			[Routes in Context]
		formatString: #,0
		displayFolder: 08 Management Overview
		lineageTag: 5d9a7b2e-4d3b-4e2f-b980-2c3d4e5f6071

	measure '% of Scheduled Trips' =
			
			[Mode Share of Scheduled Trips]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 08 Management Overview
		lineageTag: 6eab8c3f-5e4c-4f30-ca91-3d4e5f607182

	measure '% of Observed Services' =
			
			[Mode Share of Observed Services]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 08 Management Overview
		lineageTag: 7fbc9d40-6f5d-4031-dba2-4e5f60718293

	measure 'Median Delay' =
			
			[Median Observed Estimated Delay (min)]
		formatString: #,0.0
		displayFolder: 08 Management Overview
		lineageTag: 80cdae51-706e-4142-ecb3-5f607182934a

	measure 'P95 Delay' =
			
			[P95 Observed Estimated Delay (min)]
		formatString: #,0.0
		displayFolder: 08 Management Overview
		lineageTag: 91debf62-817f-4253-fdc4-607182934a5b

	measure 'Insight Largest Planned Mode' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__ScheduledTrips", CALCULATE ( [Scheduled Trips] ),
			        "__Share", CALCULATE ( [Mode Share of Scheduled Trips] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER ( ModeRows, [__ScheduledTrips] > 0 ),
			        [__ScheduledTrips], DESC,
			        Mode[ModeDetail], ASC
			    )
			VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
			VAR ModeShare = MAXX ( TopMode, [__Share] )
			RETURN
			    IF (
			        ISBLANK ( ModeName ),
			        "No scheduled trip data is available for the current selection.",
				"Largest planned mode: " & ModeName & " ("
				    & FORMAT ( ModeShare, "0.0%" ) & " of scheduled trips)."
			    )
		displayFolder: 08 Management Overview
		lineageTag: a2efc073-9280-4364-aed5-7182934a5b6c

	measure 'Insight Highest Typical Delay' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__ObservedServices", CALCULATE ( [Observed Matched Services] ),
			        "__MedianDelay", CALCULATE ( [Median Observed Estimated Delay (min)] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER (
			            ModeRows,
			            [__ObservedServices] > 0
			                && NOT ISBLANK ( [__MedianDelay] )
			        ),
			        [__MedianDelay], DESC,
			        Mode[ModeDetail], ASC
			    )
			VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
			VAR MedianDelay = MAXX ( TopMode, [__MedianDelay] )
			RETURN
			    IF (
			        ISBLANK ( ModeName ),
			        "No observed delay evidence is available for the current selection.",
				"Highest median delay: " & ModeName & " ("
				    & FORMAT ( MedianDelay, "#,0.0" ) & " min)."
			    )
		displayFolder: 08 Management Overview
		lineageTag: b3f0d184-a391-4475-bfe6-8293a5b6c7d8

	measure 'Insight Highest Severe Delay' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__ObservedServices", CALCULATE ( [Observed Matched Services] ),
			        "__P95Delay", CALCULATE ( [P95 Observed Estimated Delay (min)] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER (
			            ModeRows,
			            [__ObservedServices] > 0
			                && NOT ISBLANK ( [__P95Delay] )
			        ),
			        [__P95Delay], DESC,
			        Mode[ModeDetail], ASC
			    )
			VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
			VAR P95Delay = MAXX ( TopMode, [__P95Delay] )
			RETURN
			    IF (
			        ISBLANK ( ModeName ),
			        "No observed severe-delay evidence is available for the current selection.",
				"Highest P95 delay: " & ModeName & " ("
				    & FORMAT ( P95Delay, "#,0.0" ) & " min)."
			    )
		displayFolder: 08 Management Overview
		lineageTag: c401e295-b4a2-4586-c0f7-93a4b6c7d8e9

	measure 'Insight Observed Sample Composition' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__ObservedServices", CALCULATE ( [Observed Matched Services] ),
			        "__Share", CALCULATE ( [Mode Share of Observed Services] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER ( ModeRows, [__ObservedServices] > 0 ),
			        [__ObservedServices], DESC,
			        Mode[ModeDetail], ASC
			    )
			VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
			VAR ModeShare = MAXX ( TopMode, [__Share] )
			RETURN
			    IF (
			        ISBLANK ( ModeName ),
			        "No observed services are available for the current selection.",
				"Sampling Panel mix: " & FORMAT ( ModeShare, "0.0%" ) & " "
				    & ModeName & "."
			    )
		displayFolder: 08 Management Overview
		lineageTag: d512f3a6-c5b3-4697-d108-a4b5c7d8e9f0

	measure 'Typical Scheduled Duration' =
			
			VAR TripRows =
			    CALCULATETABLE (
			        ScheduledTripProfile,
			        TREATAS ( VALUES ( Route[RouteKey] ), ScheduledTripProfile[RouteKey] ),
			        TREATAS ( VALUES ( Mode[ModeKey] ), ScheduledTripProfile[ModeKey] )
			    )
			RETURN
			    MEDIANX (
			        TripRows,
			        ScheduledTripProfile[TripScheduledDurationMinutes]
			    )
		formatString: #,0.0\ min
		displayFolder: 08 Management Overview
		lineageTag: 9b2d4f6a-8e0c-1b3d-5f7a-49c0e1d2a3b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Typical Route Length' =
			
			VAR TripRows =
			    CALCULATETABLE (
			        ScheduledTripProfile,
			        TREATAS ( VALUES ( Route[RouteKey] ), ScheduledTripProfile[RouteKey] ),
			        TREATAS ( VALUES ( Mode[ModeKey] ), ScheduledTripProfile[ModeKey] )
			    )
			RETURN
			    MEDIANX (
			        FILTER (
			            TripRows,
			            NOT ISBLANK ( ScheduledTripProfile[TripScheduledRouteLengthKm] )
			        ),
			        ScheduledTripProfile[TripScheduledRouteLengthKm]
			    )
		formatString: #,0.0\ km
		displayFolder: 08 Management Overview
		lineageTag: 6e0a2c4b-5d7f-8e9a-1b3c-25d6e7f8091a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Parent Station KPI Support' =
			
			IF (
			    ISBLANK ( [Baseline Stop Positions] ),
			    "Stop positions unavailable",
			    FORMAT ( [Baseline Stop Positions], "#,0" ) & " Stop Positions"
			)
		displayFolder: 08 Management Overview
		lineageTag: 7f1b3d5c-6e8a-9f0b-2c4d-36e7f8091a2b

	measure 'Delay Threshold (Minutes)' =
			
			SELECTEDVALUE ( 'Delay Threshold (Minutes)'[Value], 0 )
		formatString: 0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000001

	measure 'Comparable Scheduled Trips' =
			
			COUNTROWS ( ManagementComparableTrip )
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000002

	measure 'Scheduled Trips in Monitored Scope' =
			
			[Comparable Scheduled Trips]
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000003

	measure 'Observed Realtime Trips' =
			
			CALCULATE (
			    COUNTROWS ( ManagementComparableTrip ),
			    ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000004

	measure 'Observed Matched Trips' =
			
			[Observed Realtime Trips]
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000005

	measure 'On-Time Trips' =
			
			CALCULATE (
			    COUNTROWS ( ManagementComparableTrip ),
			    FILTER (
			        ManagementComparableTrip,
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			            && ABS ( ManagementComparableTrip[FinalObservedEstimatedDelayMinutes] )
			                <= [Delay Threshold (Minutes)]
			    )
			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000006

	measure 'Delayed Trips' =
			
			CALCULATE (
			    COUNTROWS ( ManagementComparableTrip ),
			    FILTER (
			        ManagementComparableTrip,
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			            && ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
			                > [Delay Threshold (Minutes)]
			    )
			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000007

	measure 'Early Trips' =
			
			CALCULATE (
			    COUNTROWS ( ManagementComparableTrip ),
			    FILTER (
			        ManagementComparableTrip,
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			            && ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
			                < ( 0 - [Delay Threshold (Minutes)] )
			    )
			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000008

	measure 'On-Time %' =
			
			DIVIDE ( [On-Time Trips], [Observed Realtime Trips] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000009

	measure 'Delayed %' =
			
			DIVIDE ( [Delayed Trips], [Observed Realtime Trips] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000010

	measure 'Early %' =
			
			DIVIDE ( [Early Trips], [Observed Realtime Trips] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000011

	measure 'Average Schedule Difference Minutes' =
			
			AVERAGEX (
			    FILTER (
			        ManagementComparableTrip,
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			    ),
			    ManagementComparableTrip[FinalObservedEstimatedDelayMinutes]
			)
		formatString: #,0.0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000012

	measure 'Average Absolute Schedule Gap Minutes' =
			
			AVERAGEX (
			    FILTER (
			        ManagementComparableTrip,
			        ManagementComparableTrip[HasValidRealtimeObservation] = TRUE ()
			    ),
			    ABS ( ManagementComparableTrip[FinalObservedEstimatedDelayMinutes] )
			)
		formatString: #,0.0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000013

	measure 'Mode Route Count' =
			
			SUM ( Mode[RouteCount] )
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000014

	measure 'Network Parent Stations' =
			
