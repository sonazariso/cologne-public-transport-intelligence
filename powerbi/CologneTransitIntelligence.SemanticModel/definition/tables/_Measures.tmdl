			)
		displayFolder: 04 Evidence
		lineageTag: ba48ff5c-3164-406f-aba6-85c687dda0f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Platform Unchanged Evidence Outcomes' =
			
			COALESCE (
			    CALCULATE (
			        [Observed Matched Services],
			        RT_ReliabilityOutcome[PlatformChangeEvidence] = "Unchanged"
			    ),
			    0
			)
		formatString: 0
		displayFolder: 04 Evidence
		lineageTag: c1ab4256-9ddc-4af2-8f71-86bb41797615

	measure 'Platform Unknown Evidence Outcomes' =
			
			CALCULATE (
			    [Observed Matched Services],
			    RT_ReliabilityOutcome[PlatformChangeEvidence] = "Unknown"
			)
		formatString: 0
		displayFolder: 04 Evidence
		lineageTag: 8bf3e87a-6aaa-41d0-a824-efc3e7442a2a

	measure 'Platform Unchanged Evidence Share' =
			
			DIVIDE (
			    [Platform Unchanged Evidence Outcomes],
			    [Observed Matched Services],
			    0
			)
		displayFolder: 04 Evidence
		lineageTag: 170eab5a-9f99-49f7-95a8-ea5e1c9faeef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Platform Unknown Evidence Share' =
			
			DIVIDE (
			    [Platform Unknown Evidence Outcomes],
			    [Observed Matched Services]
			)
		displayFolder: 04 Evidence
		lineageTag: 4d9eefdf-0c75-46e7-92d6-e1f013c4f0a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

