			)
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000027

	measure 'Station On-Time %' =
			
			DIVIDE ( [Station On-Time Trips], [Station Observed Realtime Trips] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 09 M01 System Overview
