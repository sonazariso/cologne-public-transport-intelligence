	measure 'Realtime Data End Date' =
			
			MAX ( ManagementMonitoredStation[CollectionDateLocal] )
		formatString: Short Date
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000018

	measure 'Realtime Observed Days' =
			
			DISTINCTCOUNT ( ManagementMonitoredStation[DateKey] )
		formatString: #,0
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000019

	measure 'Realtime Covered Days' =
			
