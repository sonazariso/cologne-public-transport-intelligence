	measure 'Best Performing Mode Name' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__OnTime", CALCULATE ( [On-Time %] ),
			        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
			        "__Observed", CALCULATE ( [Observed Realtime Trips] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
			        [__OnTime], DESC,
			        [__Gap], ASC,
			        [__Observed], DESC,
			        Mode[ModeDetail], ASC
			    )
			RETURN
			    MAXX ( TopMode, Mode[ModeDetail] )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000030

	measure 'Worst Performing Mode Name' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__OnTime", CALCULATE ( [On-Time %] ),
			        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
			        "__Observed", CALCULATE ( [Observed Realtime Trips] )
			    )
			VAR BottomMode =
			    TOPN (
			        1,
			        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
			        [__OnTime], ASC,
			        [__Gap], ASC,
			        [__Observed], DESC,
			        Mode[ModeDetail], ASC
			    )
			RETURN
			    MAXX ( BottomMode, Mode[ModeDetail] )
		displayFolder: 09 M01 System Overview
		lineageTag: a0000000-0000-0000-0000-000000000031

	measure 'Best Performing Mode' =
			
			VAR ModeRows =
			    ADDCOLUMNS (
			        ALLSELECTED ( Mode[ModeDetail] ),
			        "__OnTime", CALCULATE ( [On-Time %] ),
			        "__Gap", CALCULATE ( [Average Absolute Schedule Gap Minutes] ),
			        "__Observed", CALCULATE ( [Observed Realtime Trips] )
			    )
			VAR TopMode =
			    TOPN (
			        1,
			        FILTER ( ModeRows, [__Observed] > 0 && NOT ISBLANK ( [__OnTime] ) ),
			        [__OnTime], DESC,
			        [__Gap], ASC,
			        [__Observed], DESC,
			        Mode[ModeDetail], ASC
			    )
			VAR ModeName = MAXX ( TopMode, Mode[ModeDetail] )
			VAR ModePct = MAXX ( TopMode, [__OnTime] )
			VAR ObservedTrips = MAXX ( TopMode, [__Observed] )
			RETURN
			    IF (
			        ISBLANK ( ModeName ),
			        "No observed realtime trips are available for the current selection.",
			        ModeName & " | "
			            & FORMAT ( ModePct, "0.0%", "en-US" ) & " | "
			            & FORMAT ( ObservedTrips, "#,##0", "en-US" ) & " trips"
			    )
		displayFolder: 09 M01 System Overview
