	measure 'Used Stop Positions' =
			
			CALCULATE (
			    COUNTROWS ( StopPosition ),
			    StopPosition[IsUsedInCurrentSchedule] = TRUE ()
			)
		formatString: #,0
		displayFolder: 02 Network Baseline
		lineageTag: 7494e2f8-5218-49ad-99f3-b9d63908c33e

	measure 'Unused Stop Positions' =
			
			CALCULATE (
			    COUNTROWS ( StopPosition ),
			    StopPosition[IsUsedInCurrentSchedule] = FALSE ()
			)
		formatString: #,0
		displayFolder: 02 Network Baseline
		lineageTag: e7bc0b69-35cd-4415-9487-3ba5afe82f40

	/// Count of matched operational stop outcomes available for validated
	/// realtime reliability analysis.
	measure 'Observed Matched Services' =
			
			COUNTROWS ( RT_ReliabilityOutcome )
		formatString: #,0
		displayFolder: 03 Realtime Reliability
		lineageTag: d498b684-c8f5-4614-b36e-7fc42359e199

	measure 'Delay Observations' =
			
			COUNT ( RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes] )
		formatString: #,0
		displayFolder: 03 Realtime Reliability
		lineageTag: 454edb5c-e930-49f8-8472-258f87fc5564

	measure 'Average Observed Estimated Delay (min)' =
			
			AVERAGE (
			    RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			)
		formatString: #,0.0
		displayFolder: 03 Realtime Reliability
		lineageTag: 1214f78a-3e00-4899-abd2-982348557f92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Observed Estimated Delay (min)' =
			
			MEDIANX (
			    FILTER (
			        RT_ReliabilityOutcome,
			        NOT ISBLANK (
			            RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			        )
			    ),
			    RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			)
		formatString: #,0.0
		displayFolder: 03 Realtime Reliability
		lineageTag: b331bcd0-31fe-4e53-8ca0-e154ab48efea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P95 Observed Estimated Delay (min)' =
			
			PERCENTILEX.INC (
			    FILTER (
			        RT_ReliabilityOutcome,
			        NOT ISBLANK (
			            RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			        )
			    ),
			    RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes],
			    0.95
			)
		formatString: #,0.0
		displayFolder: 03 Realtime Reliability
		lineageTag: 22963654-18c6-44b6-a110-2bd611add83a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Minimum Observed Estimated Delay (min)' =
			
			MIN (
			    RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			)
		formatString: #,0.0
		displayFolder: 03 Realtime Reliability
		lineageTag: 6a069ffc-77ce-45dc-8d91-f80d43d89e36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Maximum Observed Estimated Delay (min)' =
			
			MAX (
			    RT_ReliabilityOutcome[FinalObservedEstimatedDelayMinutes]
			)
		formatString: #,0.0
		displayFolder: 03 Realtime Reliability
		lineageTag: 5a6a43bc-27a8-447e-a85d-f6b369406a81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Observations per Outcome' =
			
			AVERAGE (
			    RT_ReliabilityOutcome[ObservationCount]
			)
		formatString: #,0.00
		displayFolder: 03 Realtime Reliability
		lineageTag: 2e29a229-68fb-469e-bf9f-a8eaf424b9f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Situation-Linked Outcomes' =
			
			CALCULATE (
			    [Observed Matched Services],
			    RT_ReliabilityOutcome[HasSituationEvidence] = TRUE ()
			)
		formatString: #,0
		displayFolder: 04 Evidence
		lineageTag: 3b63d469-9f0e-42b6-aec3-b2d985b929a9

	measure 'Situation Evidence Share' =
			
			DIVIDE (
			    [Situation-Linked Outcomes],
			    [Observed Matched Services]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 04 Evidence
		lineageTag: 7dff8496-b7e7-4ef5-8d38-131098cf850d

	measure 'Platform Changed Evidence Outcomes' =
			
			CALCULATE (
			    [Observed Matched Services],
			    RT_ReliabilityOutcome[PlatformChangeEvidence] = "Changed"
			)
		formatString: #,0
		displayFolder: 04 Evidence
		lineageTag: 6914f4a6-133c-4cf6-98d0-07627f742cc2

	measure 'Platform Changed Evidence Share' =
			
			DIVIDE (
