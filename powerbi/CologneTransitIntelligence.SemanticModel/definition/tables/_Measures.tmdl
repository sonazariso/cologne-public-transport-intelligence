table _Measures
	lineageTag: b38aedee-f2b9-4691-bb66-c4c22e4cd53b

	measure 'Scheduled Trips' =
			
			SUM ( DailySchedule[ScheduledTripCount] )
		formatString: 0
		displayFolder: 01 Static Schedule
		lineageTag: cbb19cc5-b59a-480f-a6e5-5c135a43be7d

	measure 'Active Dates in Context' =
			
			DISTINCTCOUNT ( DailySchedule[DateKey] )
		formatString: 0
		displayFolder: 01 Static Schedule
		lineageTag: 39733a6c-f9ff-419a-9cfa-7c689d91c0ff

	measure 'Routes in Context' =
			
			DISTINCTCOUNT ( DailySchedule[RouteKey] )
		formatString: 0
		displayFolder: 01 Static Schedule
		lineageTag: 534a6ab0-eb05-4d79-a0e4-92fa2ea6650e

	measure 'Average Scheduled Trips per Active Day' =
			
			DIVIDE (
			    [Scheduled Trips],
			    [Active Dates in Context]
			)
		formatString: 0.00
		displayFolder: 01 Static Schedule
		lineageTag: 308f3f01-34c9-4643-a963-cda8dc1737ff

	measure 'Weekend Share' =
			
			DIVIDE (
			    [Weekend Scheduled Trips],
			    [Scheduled Trips]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 01 Static Schedule
		lineageTag: 9021d09f-889c-418a-96cb-34f96664d05d

	measure 'Mode Share of Scheduled Trips' =
			
			DIVIDE (
			    [Scheduled Trips],
			    CALCULATE (
			        [Scheduled Trips],
			        REMOVEFILTERS ( Mode[ModeDetail] )
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 01 Static Schedule
		lineageTag: d36fde52-aa38-4f20-a022-183d5d9e845e

	measure 'Weekend Scheduled Trips' =
			
			CALCULATE (
			    [Scheduled Trips],
			    KEEPFILTERS ( ActiveDate[IsWeekend] = TRUE () )
			)
		formatString: 0
		displayFolder: 01 Static Schedule
		lineageTag: 4a80c147-e0f9-4db7-9cf6-96e85d990549

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Weekday Scheduled Trips' =
			
			CALCULATE (
			    [Scheduled Trips],
			    KEEPFILTERS ( ActiveDate[IsWeekend] = FALSE () )
			)
		formatString: 0
		displayFolder: 01 Static Schedule
		lineageTag: 04dd82f8-1c8f-4ee7-9dda-31d768ee55f5

	measure 'Baseline Agencies' =
			
