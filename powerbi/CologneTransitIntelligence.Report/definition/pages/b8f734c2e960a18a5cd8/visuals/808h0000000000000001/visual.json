  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Interpretation guardrails",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Realtime findings are consolidated matched scheduled stop events from the seven-location Sampling Panel. Static GTFS is the scheduled baseline; realtime values are observed estimates.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "StaticCoverageMissing and Unresolved remain Data Quality states. Situation Evidence is contextual association, not confirmed causality.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5F6B6D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Platform Evidence: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": "Changed",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": " means planned and observed estimated platform/bay values differ; ",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "Unchanged",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": " means comparable values match; ",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": "Unknown",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  },
                  {
                    "value": " means evidence is insufficient.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Platform Unknown != Platform Unchanged. Missing estimated platform/bay information is not Unchanged.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5F6B6D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Cancellation / departure limitation: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": "the current realtime implementation is arrival-oriented. Cancellation and departure semantics are not sufficiently validated, so no validated cancellation-rate, departure-reliability, or departure-delay KPI is presented. A missing observation is not a cancellation.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Collector Health and Coverage are evaluated separately from Reliability.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#5F6B6D"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
