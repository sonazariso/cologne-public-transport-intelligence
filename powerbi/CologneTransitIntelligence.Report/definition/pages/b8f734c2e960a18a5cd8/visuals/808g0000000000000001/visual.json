                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Sampling Panel scope: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": "Seven configured realtime locations provide sampled evidence, not a complete measurement of the Cologne realtime network.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Delay terminology: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": "Observed Estimated Delay · Final Observed Estimated Delay · Latest Observed Estimated Arrival are source estimates, not confirmed physical arrival timestamps.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Reliability methodology: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": "Average, Median and P95 are continuous metrics; no arbitrary On-Time threshold or unapproved delay bands are used.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Situation Evidence",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#0B6E8A"
                    }
                  },
                  {
                    "value": " is contextual association, not confirmed causality.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F2933"
                    }
